      "max_in_flight": 1,
      "tasks": ["validation_10_v01_empty_room"],
      "reasoning_effort": "low",
      "max_tokens": 1024,
      "spend_cap_usd": 1.0,
      "timeout": 60,
      "max_attempts": 2
    }
  }
