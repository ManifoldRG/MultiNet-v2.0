# The image only needs demo/, gridworld/, interface/, mazes/, scripts/ (see
# Dockerfile). Everything below is either excluded by that or is build noise
# that would bloat the layer and bust the cache on every commit.

.git
.gitignore
__pycache__
**/__pycache__
*.pyc
*.pyo
*.egg-info
build/
dist/
.venv
venv/
.pytest_cache
.mypy_cache
.DS_Store

# Not reached by the API surface. Verified by importing demo.api.app and
# reading sys.modules - do not add to this list from intuition, the import
# chain is deeper than the directory names suggest (interface.coords reaches
# prompting_experiments, which is why it is NOT excluded here).
tests/
docs/
analysis/
adapters/
cross_domain/
multigrid/
ogbench/
deploy/
lib/
*.sh
